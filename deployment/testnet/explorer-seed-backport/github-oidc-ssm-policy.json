{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DiscoverPublicTestnetSeeds",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ssm:DescribeInstanceInformation",
        "ssm:GetCommandInvocation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UseOnlyRunShellScriptDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:ap-south-1::document/AWS-RunShellScript"
    },
    {
      "Sid": "CommandOnlyTaggedSudharmaTestnetSeeds",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:ap-south-1:981626123397:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/SudharmaManaged": "PublicTestnetSeed"
        }
      }
    }
  ]
}
