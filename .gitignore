# Sudharma Network - Git Ignore

# Private wallets and keys
wallets/
*.wallet
*-treasury.json
*-treasury.wallet
*-development-wallet.json
*-dev-wallet.json
*.pem
*.key
*.keystore
*.p12
*.pfx
*.jks

# Recovery material
*.mnemonic
*.seed
*.seedphrase
*.recovery

# Environment and secrets
.env
.env.*
*.secret
secrets/

# Android wallet local/build/signing data
mobile/android/.gradle/
mobile/android/**/build/
mobile/android/local.properties
mobile/android/keystore.properties
mobile/android/google-services.json
mobile/android/**/google-services.json
mobile/android/*.jks
mobile/android/*.keystore
*.apk
*.aab

# Node runtime data
node_modules/
data/
data-*/

# Website build artifacts (Amplify builds from source)
web/.next/
web/out/
web/test-results/
web/playwright-report/

# Public website config written by provision-website-visitor-counter workflow
!web/public/data/
!web/public/data/visitor-counter.json

# Development backups
*_backup_*
*backup-before*
*backup_before*
*.bak

# Go build artifacts
*.exe
*.test
*.out

# IDE files
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log
.worktrees/

# Local migration backup
go.mod.backup-before-step55e7

# Historical local migration / repair scripts
apply_step*.ps1
fix_step*.ps1
repair_step*.ps1

# Historical source snapshots
*.go.txt

# Local Step 56 safety backups
*.backup-step*
