{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/developers/[topic]",
      "regex": "^/developers/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtopic": "nxtPtopic"
      },
      "namedRegex": "^/developers/(?<nxtPtopic>[^/]+?)(?:/)?$"
    },
    {
      "page": "/mining/[topic]",
      "regex": "^/mining/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtopic": "nxtPtopic"
      },
      "namedRegex": "^/mining/(?<nxtPtopic>[^/]+?)(?:/)?$"
    }
  ],
