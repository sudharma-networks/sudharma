c:["$","section",null,{"className":"info-card page-stack","children":[["$","p",null,{"className":"eyebrow","children":"OUR STORY"}],["$","h2",null,{"children":"Curiosity became a network."}],["$","p",null,{"children":"We are students from India working to turn curiosity, experimentation and engineering into a blockchain ecosystem that people can explore, test, improve and build upon."}],["$","p",null,{"children":"Sudharma began with the belief that meaningful technology does not have to start inside a large institution. It can begin with learners who are willing to study difficult problems, publish their work, accept feedback and keep improving what they build."}],["$","p",null,{"children":"Our goal is not to create a project that is useful in only one way. We want each part of Sudharma to give people a genuine reason to participate, whether they arrive as users, miners, developers or simply as people who want to learn."}]]}]
d:["$","section",null,{"className":"card-grid","children":[["$","article",null,{"className":"info-card","children":[["$","p",null,{"className":"eyebrow","children":"USE"}],["$","h2",null,{"children":"Use Sudharma"}],["$","p",null,{"children":"A wallet holder or testnet participant should find an accessible way to learn how the network works, send transactions, explore releases and participate without needing to be a protocol expert first."}],["$","$L5",null,{"className":"text-link","href":"/wallet","children":"Explore the wallet →"}]]}],["$","article",null,{"className":"info-card","children":[["$","p",null,{"className":"eyebrow","children":"MINE"}],["$","h2",null,{"children":"Mine Sudharma"}],["$","p",null,{"children":"Miners should be able to contribute computing power with practical GPU hardware, verify performance openly and help us improve mining compatibility across NVIDIA, AMD and other OpenCL-capable devices."}],["$","$L5",null,{"className":"text-link","href":"/mining","children":"Explore mining →"}]]}],["$","article",null,{"className":"info-card","children":[["$","p",null,{"className":"eyebrow","children":"BUILD"}],["$","h2",null,{"children":"Build on Sudharma"}],["$","p",null,{"children":"Developers should find source code, APIs, documentation and infrastructure that invite experimentation. Sudharma is open source because we want good ideas and careful engineering to come from beyond the original team."}],["$","$L5",null,{"className":"text-link","href":"/developers","children":"Developer resources →"}]]}]]}]
e:["$","section",null,{"className":"info-card page-stack","children":[["$","p",null,{"className":"eyebrow","children":"OPEN SOURCE · OPEN PARTICIPATION"}],["$","h2",null,{"children":"Built in public, improved in public."}],["$","p",null,{"children":"We are still students, and Sudharma is still growing. We see that as a strength. The project is being developed in public so mistakes can become improvements, experiments can become working technology and contributors from anywhere in the world can help shape what comes next."}],["$","p",null,{"children":"Holding or using SUDH, mining, running software or contributing code can each be a different way to participate in the same open ecosystem. Sudharma does not promise guaranteed financial returns, effortless profits or risk-free outcomes. Our responsibility is to build useful technology, communicate its current readiness clearly and keep improving the experience for people who choose to participate."}]]}]
f:["$","section",null,{"className":"info-card page-stack","children":[["$","p",null,{"className":"eyebrow","children":"WHY WE ARE BUILDING"}],["$","h2",null,{"children":"More than another cryptocurrency."}],["$","p",null,{"children":"Sudharma is an attempt to build an open technological foundation and discover how far determined learners, builders, miners, users and contributors can take it together. A useful network should reward curiosity with knowledge, participation with capability and contribution with visible progress."}],["$","p",null,{"children":"From India, open to the world."}],["$","div",null,{"className":"hero-actions","children":[["$","$L5",null,{"className":"button primary","href":"/testnet","children":"Join the Testnet"}],["$","a",null,{"className":"button secondary","href":"https://github.com/sudharma-networks/sudharma","children":"View GitHub ↗"}]]}]]}]
