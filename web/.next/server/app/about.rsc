8:["$","h1",null,{"children":"Built in India. Built to be open. Built for everyone."}]
9:["$","p",null,{"className":"lead","children":"Sudharma Network is a student-built blockchain project created in India with a simple ambition: learn deeply, build openly and contribute something meaningful to decentralized technology."}]
